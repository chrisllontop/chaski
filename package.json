{
  "name": "chaski",
  "version": "0.0.1",
  "description": "Embeddable notification infrastructure for Cloudflare Workers, dashboard included.",
  "keywords": [
    "cloudflare-workers",
    "notifications",
    "email",
    "web-push",
    "push-notifications",
    "in-app-notifications",
    "notification-feed",
    "durable-objects",
    "cloudflare-d1",
    "hono",
    "typescript",
    "dashboard"
  ],
  "homepage": "https://chaski.sh",
  "bugs": {
    "url": "https://github.com/chrisllontop/chaski/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisllontop/chaski.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
