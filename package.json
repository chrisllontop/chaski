{
  "name": "chaski",
  "version": "0.0.1",
  "description": "Embeddable notification infrastructure for Cloudflare Workers, dashboard included.",
  "keywords": [
    "cloudflare-workers",
    "notifications",
    "email",
    "web-push",
    "push-notifications",
    "in-app-notifications",
    "notification-feed",
    "durable-objects",
    "cloudflare-d1",
    "hono",
    "typescript",
    "dashboard"
  ],
  "homepage": "https://chaski.sh",
  "bugs": {
    "url": "https://github.com/chrisllontop/chaski/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisllontop/chaski.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client.js"
    },
    "./sw": {
      "types": "./dist/sw/index.d.ts",
      "import": "./dist/sw.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations/*.sql"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "hono": "^4.8.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "pnpm build:dashboard && wrangler dev -c test/fixture/wrangler.jsonc --var CHASKI_DRY_RUN:true",
    "build:dashboard": "vite build",
    "build:types": "tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --outDir dist --rootDir src && tsc -p tsconfig.browser.json --noEmit false --declaration --emitDeclarationOnly --outDir dist --rootDir src && node scripts/fix-declaration-imports.ts dist",
    "build": "pnpm build:dashboard && tsdown && pnpm build:types",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && tsc -p src/dashboard/tsconfig.json && tsc -p test/tsconfig.json && tsc -p test/browser/tsconfig.json && tsc -p test/sw/tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm build:dashboard && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-kit": "^0.31.11",
    "get-nonce": "^1.0.1",
    "happy-dom": "^21.0.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.8.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "better-drizzle": "^0.2.0",
    "drizzle-orm": "^0.45.4",
    "liquidjs": "^10.30.0",
    "zod": "^4.6.7"
  }
}
