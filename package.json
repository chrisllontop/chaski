{
  "name": "chaski",
  "version": "0.0.1",
  "description": "Embeddable notification infrastructure for Cloudflare Workers, dashboard included.",
  "keywords": [
    "cloudflare-workers",
    "notifications",
    "email",
    "web-push",
    "push-notifications",
    "in-app-notifications",
    "notification-feed",
    "durable-objects",
    "cloudflare-d1",
    "hono",
    "typescript",
    "dashboard"
  ],
  "homepage": "https://chaski.sh",
  "bugs": {
    "url": "https://github.com/chrisllontop/chaski/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisllontop/chaski.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "hono": "^4.8.0"
  },
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "scripts": {
    "build:dashboard": "vite build",
    "build": "pnpm build:dashboard && tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/dashboard/tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm build:dashboard && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
