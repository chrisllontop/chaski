# Headers every response gets. The Content-Security-Policy isn't here: scripts/headers.ts gives each
# page its own, allowing that page's inline scripts by hash. A policy on /* would also apply to the
# pages and block those scripts: on the home page, Cloudflare kept it even under
# `! Content-Security-Policy`.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The asset server sends Markdown and text without a charset, which would read the curly quotes in
# the docs and the skill as Latin-1.
/docs/*.md
  Content-Type: text/markdown; charset=utf-8

/skill/*.md
  Content-Type: text/markdown; charset=utf-8

/skill/*.mjs
  Content-Type: text/javascript; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8
